# 30 pareto front approximations from experiments exp1 vs exp2
# Auto-generated by run_experiments.py
# Change exp1/exp2/run_end/obj columns in gnuplot and use: replot

data_dir="../../logs"
exp1=1
exp2=2
run_start=1
run_end=5
obj_x_col=4
obj_y_col=5

set grid
set xlabel 'Objective column '.obj_x_col
set ylabel 'Objective column '.obj_y_col
set yrange [*:*]
set title 'Experiments '.exp1.' vs '.exp2.': Pareto Front Approximations of runs '.run_start.'..'.run_end
# TIP: set xrange [0:<value>] / set yrange [0:<value>] if needed
plot data_dir.'/'.exp1.'_'.run_start.'.tsv' using obj_x_col:obj_y_col title sprintf('Exp %d',exp1) smooth unique lt 1,\
     for [i=run_start+1:run_end] data_dir.'/'.exp1.'_'.i.'.tsv' using obj_x_col:obj_y_col smooth unique lt 1 notitle,\
     data_dir.'/'.exp1.'_'.run_start.'.tsv' using obj_x_col:obj_y_col w p lt 1 notitle,\
     for [i=run_start+1:run_end] data_dir.'/'.exp1.'_'.i.'.tsv' using obj_x_col:obj_y_col w p lt 1 notitle,\
     data_dir.'/'.exp2.'_'.run_start.'.tsv' using obj_x_col:obj_y_col title sprintf('Exp %d',exp2) smooth unique lt 2,\
     for [i=run_start+1:run_end] data_dir.'/'.exp2.'_'.i.'.tsv' using obj_x_col:obj_y_col smooth unique lt 2 notitle,\
     data_dir.'/'.exp2.'_'.run_start.'.tsv' using obj_x_col:obj_y_col w p lt 2 notitle,\
     for [i=run_start+1:run_end] data_dir.'/'.exp2.'_'.i.'.tsv' using obj_x_col:obj_y_col w p lt 2 notitle

pause -1 'Press Enter to continue'
