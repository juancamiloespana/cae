# Index script to visualize generated plots in sequence
# Static script (not generated by run_metrics.py)
# Run from project root: gnuplot scripts/IndexPlots.plot

set terminal wxt
plots_dir = "data/results/plots"

print ''
print '=========================================='
print 'Plot index: generated visualizations'
print '=========================================='
print ''

home_dir = GPVAL_PWD
cd plots_dir
print '1) Hypervolume boxplot'
pause -1 'Press Enter to load HVBoxplot.plot'
load './HVBoxplot.plot'
print ''

print '2) Epsilon boxplot'
pause -1 'Press Enter to load EpsilonBoxplot.plot'
load './EpsilonBoxplot.plot'
print ''

print '3) Reference fronts comparison'
pause -1 'Press Enter to load RefFronts.plot'
load './RefFronts.plot'
print ''

print '4) Runs comparison: Exp-A vs Exp-B'
pause -1 'Press Enter to load ParetoRunsExpA_vs_ExpB.plot'
load './ParetoRunsExpA_vs_ExpB.plot'
print ''

print 'End of plot index.'
pause -1 'Press Enter to finish'

cd home_dir