#
# Boxplot of hypervolume values by experiment
# Auto-generated by run_metrics.py
#

exps="1 2 3 4 5"
data_dir=".."

reset
set grid
set title "Quality and Stability of experiments"
set ylabel "Hypervolume"
set style fill solid 0.5 border -1
set style boxplot outliers pointtype 7
set style data boxplot
set boxwidth 0.5
set pointsize 0.5
unset key
set border 2
set xtics nomirror
set ytics nomirror
set yrange [0:1]
set xtics ("Exp1" 1, "Exp2" 2, "Exp3" 3, "Exp4" 4, "Exp5" 5) scale 0.0
plot for [i in exps] data_dir.'/HV-Exp'.i.'.txt' using (i+0):1
